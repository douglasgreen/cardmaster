{
    "name": "dsg/cardmaster",
    "description": "Flashcard Review Program",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "CardMaster\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/douglasgreen/pagemaker.git"
        }
    ],
    "require": {
        "php": ">=8.3.0",
        "douglasgreen/pagemaker": "dev-main"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.86",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1",
        "shipmonk/dead-code-detector": "^0.13",
        "shipmonk/name-collision-detector": "^2.1"
    },
    "scripts": {
        "fix-js": "npm run fix && npm run format && npx prettier --write .",
        "lint": [
            "detect-collisions",
            "php-cs-fixer check --verbose --diff",
            "phpstan analyse",
            "rector --dry-run"
        ],
        "lint:fix": [
            "php-cs-fixer fix --verbose --diff",
            "rector"
        ]
    }
}
